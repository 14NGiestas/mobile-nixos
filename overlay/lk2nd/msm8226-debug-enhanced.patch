@@ -1296,6 +1296,12 @@ tags_done:
 	dprintf(INFO, "booting linux @ %p, ramdisk @ %p (%d), tags/device tree @ %p\n",
 		entry, ramdisk, ramdisk_size, (void *)tags_phys);
 
+	/* IMEM FASTBOOT TRAP for MSM8226 */
+	/* 0xFE80565C = RESTART_REASON_ADDR, 0x77665500 = FASTBOOT_MODE */
+	writel(0x77665500, 0xFE80565C);
+	/* CLEAR RAMLOG (first 256 bytes of SCRATCH_ADDR) */
+	memset((void *)0x10000000, 0, 256);
+
 	enter_critical_section();
 
 	/* do any platform specific cleanup before kernel entry */
