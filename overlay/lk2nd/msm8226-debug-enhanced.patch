@@ -56,11 +58,52 @@ static int find_device_node(const void *dtb)
 		return node;
 	}
 
-	/* If root node already has a "compatible" it always matches */
-	if (fdt_getprop(dtb, lk2nd_node, "compatible", NULL))
+	/* If root node already has a "compatible" it usually matches, BUT
+	 * if we have a device from cmdline, prefer searching subnodes for device-specific match */
+	if (fdt_getprop(dtb, lk2nd_node, "compatible", NULL)) {
+		const char *match_device;
+		int match_len;
+		
+		dprintf(INFO, "find_device_node: root node has 'compatible', cmdline device=%s\n",
+			lk2nd_dev.device ? lk2nd_dev.device : "(null)");
+		
+		/* Check if root node specifies a device matching requirement */
+		match_device = fdt_getprop(dtb, lk2nd_node, "lk2nd,match-device", &match_len);
+		if (match_len != -FDT_ERR_NOTFOUND) {
+			dprintf(INFO, "find_device_node: root node HAS 'lk2nd,match-device'\n");
+			
+			if (lk2nd_dev.device) {
+				/* Root node has device matching requirement - validate it */
+				int slen = strnlen(match_device, match_len);
+				int dev_len = (int)strlen(lk2nd_dev.device);
+				dprintf(INFO, "find_device_node: comparing '%.*s' vs '%s'\n",
+					slen, match_device, lk2nd_dev.device);
+				
+				if (slen == dev_len && strncmp(lk2nd_dev.device, match_device, slen) == 0) {
+					/* Device matches, accept root node */
+					dprintf(INFO, "find_device_node: MATCH! accepting root node\n");
+					return lk2nd_node;
+				}
+				/* Device mismatch, search subnodes */
+				dprintf(INFO, "find_device_node: MISMATCH! searching subnodes\n");
+				return lk2nd_device2nd_match_device_node(dtb, lk2nd_node);
+			}
+		} else {
+			/* Root node has NO device matching requirement */
+			if (lk2nd_dev.device) {
+				/* But cmdline has a device, so search for device-specific match in subnodes */
+				dprintf(INFO, "find_device_node: root has NO device requirement but cmdline has device=%s, searching subnodes\n",
+					lk2nd_dev.device);
+				return lk2nd_device2nd_match_device_node(dtb, lk2nd_node);
+			}
+			/* No device from cmdline either, accept root node */
+			dprintf(INFO, "find_device_node: no device requirement and no cmdline device, accepting root\n");
+		}
 		return lk2nd_node;
+	}
 
 	/* Fallback to dynamic matching */
+	dprintf(INFO, "find_device_node: root has no 'compatible', searching subnodes\n");
 	return lk2nd_device2nd_match_device_node(dtb, lk2nd_node);
 }
 
